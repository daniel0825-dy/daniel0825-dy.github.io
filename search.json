---
layout: null
permalink: /search.json
---
[
{% for post in site.posts %}
  {% capture search_text %}{{ post.title }} {{ post.description | strip_html }} {{ post.categories | join: ' ' }} {{ post.tags | join: ' ' }} {{ post.content | strip_html }}{% endcapture %}
  {"url": {{ post.url | relative_url | jsonify }}, "text": {{ search_text | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
